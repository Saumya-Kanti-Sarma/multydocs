# MultyDocs onboarding (Vite) environment variables
# Copy this file to .env and fill in your own values. .env is gitignored.

# Backend API (Cloudflare Worker / express-server)
VITE_API_URL=http://localhost:8787

# Google OAuth client id (used for "Continue with Google")
VITE_GOOGLE_CLIENT_ID=your-google-client-id
